          "sample": {
            "question": "中国GDP相关指标"
          }
        },
        "economic_get_indicator_series": {
          "sample": {
            "metricCodes": "M5567876",
            "observation": 4
          }
        },
        "economic_query_indicator_series": {
          "sample": {
            "question": "中国GDP现价当季值",
