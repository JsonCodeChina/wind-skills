ixic['pct_chg']):.2f}%，科技股相对强势\")\n\nL()\nL(\"### 美股行业板块涨跌幅排名（标普500成分股·Wind二级行业）\")\nL()\nus_sectors = us.get(\"sectors\", [])\nL(\"| 排名 | 行业板块 | 涨跌幅 |\")\nL(\"|------|----------|--------|\")\nfor i, sec in enumerate(us_sectors, 1):\n    L(f\"| {i} | {sec['name']} | {fmt_pct(sec['pct_chg'])} |\")\n\nL()\nL(\"#### 领涨板块（Top 3）\")\nfor i in range(min(3, len(us_sectors))):\n    sec = us_sectors[i]\n    L(f\"{i+1}. **{sec['name']}**：{fmt_pct(sec['pct_chg'])}\")\n\nL()\nL(\"#### 领跌板块（Bottom 3）\")\nfor i in range(max(0, len(us_sectors)-3), len(us_sectors)):\n    sec = us_sectors[i]\n    idx = i + 1\n    L(f\"{idx - (len(us_sectors)-3) + 1}. **{sec['name']}**：{fmt_pct(sec['pct_chg'])}\")\n\nL()\nL(\"#### 板块特征总结\")\n# 计算正收益板块数\npos_count = sum(1 for s in us_sectors if s['pct_chg'] > 0)\nL(f\"- 能源板块（{fmt_pct(us_sectors[0]['pct_chg'])}）领涨，显示通胀/油价上行预期或地缘因素驱动\")\nL(f\"- 半导体与技术硬件板块（{fmt_pct(us_sectors[1]['pct_chg'])}、{fmt_pct(us_sectors[2]['pct_chg'])}）跟随纳指走强，科技结构性分化明显\")\nL(f\"- 大消费（耐用消费品与服装 {fmt_pct(us_sectors[-1]['pct_chg'])}、家庭与个人用品 {fmt_pct(us_sectors[-2]['pct_chg'])}）、银行（{fmt_pct(us_sectors[us_sectors.index(next(s for s in us_sectors if '银行' in s['name']))]['pct_chg'])}）跌幅居前，反映利率预期变化或消费信心走弱\")\nL(f\"- 整体板块跌多涨少，仅{pos_count}个板块录得正收益，市场情绪偏谨慎\")\n\nL()\nL(\"---\")\nL()\nL(\"## 二、A股市场概况（2026-07-09）\")\nL()\nL(\"今日A股三大指数全线大幅上涨，创业板指领涨。\")\nL()\nL(\"### 三大指数行情\")\nL()\na_indices = a.get(\"indices\", {})\nL(\"| 指数 | 收盘价 | 涨跌幅 | 最高价 | 最低价 | 前收盘 | 成交额(亿元) |\")\nL(\"|------|--------|--------|--------|--------|--------|-------------|\")\nfor name, d in [(\"上证综指\", a_indices.get(\"上证综指\", {})), \n                 (\"深证成指\", a_indices.get(\"深证成指\", {})),\n                 (\"创业板指\", a_indices.get(\"创业板指\", {}))]:\n    if not d:\n        continue\n    close = fmt_num(d[\"close\"])\n    pct = fmt_pct(d[\"pct_chg\"])\n    high = fmt_num(d[\"high\"])\n    low = fmt_num(d[\"low\"])\n    pre = fmt_num(d[\"pre_close\"])\n    amount = f\"{d['amount']/1e8:.2f}\" if d.get(\"amount\") else \"—\"\n  