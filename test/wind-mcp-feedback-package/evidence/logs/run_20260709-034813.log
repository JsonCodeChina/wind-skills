nk']}。\")\nlines.append(\"\")\n\n# 领跌板块\nlines.append(\"#### 领跌板块（Bottom 3）\\n\")\nfor s in reversed(bottom3):\n    lines.append(f\"- **{s['name']}（{s['code']}）**：{s['pct_chg']:+.2f}%，排名第{s['rank']}。\")\nlines.append(\"\")\n\n# 板块特征总结\nlines.append(\"#### 板块特征总结\\n\")\nlines.append(\"1. **整体偏弱**：{}/{} 的行业板块录得下跌，仅公用事业和信息技术小幅上涨，显示市场情绪谨慎。\".format(hk[\"negative_count\"], len(sectors)))\nlines.append(\"2. **防御板块相对抗跌**：公用事业(+0.23%)和信息科技(+0.17%)逆势小幅上涨，电讯业(-0.13%)跌幅极小，显示资金流向防御性板块。\")\nlines.append(\"3. **周期与消费板块领跌**：原材料(-2.17%)跌幅最大，必需性消费(-1.58%)和非必需性消费(-1.26%)紧随其后，反映市场对经济复苏节奏的担忧。\")\nlines.append(\"4. **金融与地产拖累指数**：金融业(-0.97%)和地产建筑业(-0.99%)作为恒指权重板块的下跌，是恒指和国企指数承压的主要原因。\")\nlines.append(\"\")\n\n# 构造最终要替换的内容\nhk_section = \"\\n\".join(lines)\n\n# 读取完整 report\nwith open(report_path) as f:\n    content = f.read()\n\n# 替换（待取数）部分\nold = \"（待取数）\"\nnew = hk_section\n\nif old in content:\n    content = content.replace(old, new, 1)\n    with open(report_path, \"w\") as f:\n        f.write(content)\n    print(\"✅ 港股章节已写入 report.md\")\nelse:\n    print(\"⚠️ 未找到 '（待取数）' 占位符，检查文件内容\")\n    # 尝试另一种方式：在 \"## 三、港股市场概况\" 后面找空行插入\n    import re\n    pattern = r\"(## 三、港股市场概况（2026-07-09）\\n+)\"\n    if re.search(pattern, content):\n        # 在标题下方替换\n        content = re.sub(pattern, r\"\\1\" + hk_section, content, 1)\n        with open(report_path, \"w\") as f:\n            f.write(content)\n        print(\"✅ 港股章节已通过正则写入 report.md\")\n    else:\n        print(\"❌ 无法找到匹配位置\")\nPYEOF\npython3 /tmp/write_hk_section.py"}
