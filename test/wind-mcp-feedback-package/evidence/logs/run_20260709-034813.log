"""通用核查器(任务无关,蓝图漏斗第 1 层):对任何临时问题的产出做底线检查。

它不懂任务内容,只管底线:有交付物、有实质内容、数字有来源标注、不复读凑字、不泄密。
内容真伪与研究成色由人评——本核查器只证伪,不证实。
"""
import re
import sys
from pathlib import Path

problems = []


def check(ok, msg):
    if not ok:
        problems.append(msg)


report = Path("report.md")
if not report.exists():
    print("不合格: 交付物 report.md 还不存在(产出型任务的最终交付物约定写到 report.md)")
    sys.exit(1)

text = report.read_text(encoding="utf-8")
body = re.sub(r"^#.*$", "", text, flags=re.M).strip()

check(len(body) >= 300, f"正文仅 {len(body)} 字,交付物近乎空白")
check(len(re.findall(r"\d", body)) >= 10, "正文几乎没有数字——金融问题的回答没有数据支撑")
check(("来源" in text) or ("Wind" in text) or ("wind" in text), "未标注任何数据来源")
def is_structural(ln):
    """Markdown 结构行(分隔线/表格行/粗体小标题/短标签)天然重复,不算凑字。"""
    return (re.fullmatch(r"[-=*_~#>\s|:.]+", ln) is not None
            or ln.startswith("|")
            or re.fullmatch(r"\*{1,2}[^*]{1,30}[:：]?\*{1,2}", ln) is not None
            or len(ln) < 10)


lines = [ln.strip() for ln in body.splitlines() if ln.strip() and not is_structural(ln.strip())]
for ln, cnt in {ln: lines.count(ln) for ln in set(lines)}.items():
    check(cnt <= 2, f"复读机凑字数被抓:「{ln[:20]}…」重复了 {cnt} 次")
check("字数" not in body, "正文出现『字数』字样——疑似凑长度,重写真实内容")
for marker in ("当前进度", "待补充"):  # 半成品标记:报告自己承认没写完
    check(marker not in body, f"正文出现『{marker}』——交付物是半成品,完成全部内容后重写")
check("ak_" not in text and "WIND_MCP_KEY" not in text, "交付物疑似泄漏 key,禁止")
for png in re.findall(r"[\w./-]+\.png", text):  # 报告引用的图必须真实存在且非空壳
    p = Path(png)
    check(p.exists() and p.stat().st_size > 10_000, f"报告引用的图 {png} 不存在或过小(疑似空图)")
for marker in ("(推算", "(推算", "(倒推", "(倒推"):  # 承重数字禁止倒推——要么取数,要么如实写"未检索到"
    check(marker not in body, f"正文出现『{marker})』标记——承重数字禁止倒推,用 wind 直接取数")
task_md = Path(".agent/task.md")  # 任务点名的交付物(如 PDF)逐个验收,不许只交 report.md 就算完
m = re.search(r"^## 交付物清单\n(.+)$", task_md.read_text(encoding="utf-8"), re.M) if task_md.exists() else None
for name in ([x.strip() for x in m.group(1).split(",")] if m else []):
    f = Path(name)
    if name.endswith(".md"):
        check(f.exists(), f"交付物 {name} 缺失")
    else:
        check(f.exists() and f.stat().st_size > 10_000, f"交付物 {name} 不存在或过小(疑似空壳)")
check("[" not in body[:200] or "|" in body, "报告开头疑似直接粘贴原始数组,须写成文字+表格")

if problems:
    print(f"不合格,共 {len(problems)} 项:")
    for p in problems:
        print(f"  - {p}")
    sys.exit(1)
print("通用核查通过:交付物存在、有实质内容、有数据与来源、无凑字无泄密(内容真伪请人工复核)")
