[01:01:03] MODEL   数据很有用！现在用python处理K线数据，计算涨跌幅、52周高低点、市盈率市净率等指标。
[01:01:03] TOOL    bash {"command": "cd /Users/lufeng/Projects/fin-agent/runs/20260709-005304 && python3 << 'PYEOF'\nimport json\n\n# 读取三只股票的K线数据\nwith open(\".agent/data/wind_008.json\") as f:\n    zyhn = json.load(f)\nwith open(\".agent/data/wind_009.json\") as f:\n    zslc = json.load(f)\nwith open(\".agent/data/wind_010.json\") as f:\n    zsny = json.load(f)\n\ndef calc_stats(data, name):\n    rows = data.get(\"data\", [])\n    if not rows:\n        print(f\"{name}: 无数据\")\n        return\n    # 提取收盘价序列\n    closes = [float(r[2]) for r in rows]  # MATCH字段\n    dates = [r[0][:10] for r in rows]     # TIME字段 YYYY-MM-DD\n    \n    first_close = closes[0]\n    last_close = closes[-1]\n    high_52w = max(closes)\n    low_52w = min(closes)\n    \n    # 涨跌幅\n    total_return = (last_close / first_close - 1) * 100\n    \n    # 近3个月(约63个交易日)\n    q3 = closes[-63:] if len(closes) >= 63 else closes\n    q3_return = (q3[-1] / q3[0] - 1) * 100\n    \n    # 近1个月(约21个交易日)\n    m1 = closes[-21:] if len(closes) >= 21 else closes\n    m1_return = (m1[-1] / m1[0] - 1) * 100\n    \n    # 年初至今(2026-01-01起)\n    ytd_idx = next((i for i, d in enumerate(dates) if d >= \"2026-01-01\"), 0)\n    ytd_closes = closes[ytd_idx:]\n    ytd_return = (ytd_closes[-1] / ytd_closes[0] - 1) * 100 if ytd_closes else 0\n    \n    print(f\"\\n===== {name} =====\")\n    print(f\"首日({dates[0]}): {first_close}\")\n    print(f\"末日({dates[-1]}): {last_close}\")\n    print(f\"52周最高: {high_52w}\")\n    print(f\"52周最低: {low_52w}\")\n    print(f\"近1年涨跌幅: {total_return:.2f}%\")\n    print(f\"年初至今涨跌幅: {ytd_return:.2f}%\")\n    print(f\"近3月涨跌幅: {q3_return:.2f}%\")\n    print(f\"近1月涨跌幅: {m1_return:.2f}%\")\n    \n    # 查看下2026年Q2高位\n    q2_closes = [c for i, (c, d) in enumerate(zip(closes, dates)) if \"2026-04\" <= d[:7] <= \"2026-06\"]\n    if q2_closes:\n        print(f\"2026Q2区间: {min(q2_closes):.2f} ~ {max(q2_closes):.2f}\")\n        print(f\"2026Q2收盘均值: {sum(q2_closes)/len(q2_closes):.2f}\")\n    \n    # 当前相对52周高位的回撤\n    drawdown = (last_close / high_52w - 1) * 100\n    print(f\"距52周高点回撤: {drawdown:.2f}%\")\n\ncalc_stats(zyhn, \"中远海能(600026.SH)\")\ncalc_stats(zslc, \"招商轮船(601872.SH)\")\ncalc_stats(zsny, \"招商南油(601975.SH)\")\nPYEOF"}
