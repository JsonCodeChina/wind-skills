#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["anthropic>=0.40", "openai>=1.60"]
# ///
"""fin-agent —— Ralph 双循环式金融 agent,单文件实现(设计见 DESIGN.md;底盘复刻自 mini-agent)。

底盘(行业无关,已在编程任务上验证):
1. 数组式记忆:上下文 = 每轮重新组装的聚焦消息数组,持久状态外置到 .agent/ 文件;
2. 最小上下文:每轮 fresh context,换出内容进 archive.jsonl(同格式落盘,可 grep 取回);
3. 评估循环:宿主强制跑验证命令,verify 绿是唯一权威完成信号,模型自报不算数。

金融特化(相对 mini-agent 的唯一结构性改动):
- 原生 `wind` 工具 —— Wind 取数走 tool-calling 结构化参数,模型不碰 shell 引号、不碰 key。
  (实测教训:取数走 bash 时模型在引号地狱里空转烧掉 37 万 token,ACI 粗糙是最大成本项。)

用法: uv run python agent.py "任务描述" --repo workflows/daily-review --verify "python3 check_review.py"
"""
import argparse
import datetime as dt
import json
import os
import signal
import subprocess
import sys
import time
from pathlib import Path
from types import SimpleNamespace as NS

import anthropic

MAX_STEPS = 25  # 内循环每轮步数上限
BASH_TIMEOUT = 120  # bash 工具超时(秒)
VERIFY_TIMEOUT = 180  # 宿主验证超时(秒),必须 > BASH_TIMEOUT
TRUNC_LINES = 30  # 工具输出保留头尾各多少行
TRUNC_CHARS = 4000  # 工具输出总字符上限(行情类单行大 JSON 按行截不住,必须按字符兜底)
DATA_SPILL_CHARS = 2000  # wind 返回超过此长度 → 落盘为数据文件,数组只留回执
NOTES_TAIL = 20  # 每轮注入最近多少条教训
VERIFY_TAIL_CHARS = 3000  # 验证输出注入下一轮的尾部长度

SYSTEM = """你是一个专注的 coding agent,在一个受控循环里工作。

# 工作方式
- **金融数据的唯一权威来源是 wind 工具(万得 Wind MCP)**:所有行情、基金、指数、
  公告新闻、宏观数据一律通过它获取;不用它拿到的数字不许写进任何交付物。
- 持久记忆在文件里,不在对话里:.agent/task.md(任务,只读)、.agent/state.json
  (计划+教训,只能通过 update_plan 工具修改)、.agent/archive.jsonl(历史档案)。
- 本轮对话结束后会被整体丢弃,只有文件改动和 update_plan 写入的内容会留下。

# 铁律
1. 每轮只做一件事:只处理"本轮指令"指定的那一件事,做完即停。
2. 改动前先搜索:动手前用 bash(grep/ls/cat)确认现状,禁止假设某功能未实现。
3. 禁止占位符/糊弄实现:不写 TODO、pass、假数据来"看起来完成"。
4. 验证未绿禁止宣告完成:验证命令是唯一裁判,你说了不算。
5. 每轮结束前必须调用 update_plan 写至少一条 note(踩的坑、学到的事),
   这是你留给下一轮的唯一记忆。
6. 禁止用 edit_file/bash 直接读写 .agent/state.json 或 task.md——
   计划和进度只能走 update_plan 工具,手写会被宿主丢弃。
7. 金融取数一律用 wind 工具(结构化参数,宿主管鉴权);
   严禁读取/打印 wind.env 或任何 key,严禁自己拼 shell 命令去调数据接口。
8. 产出型任务的最终交付物写到 report.md(除非任务另有指定);
   报告里的每个关键数字都要有来源标注,查不到的信息如实写"未检索到",不许编。
   报告是给人读的:用文字叙述+Markdown 表格,禁止直接粘贴原始数组/JSON。

# 宿主环境(画图必读)
- python3 环境已装好 matplotlib 和 pandas,禁止 pip install;
- 画中文图必须先设字体,否则中文全变方块:
  plt.rcParams["font.sans-serif"] = ["PingFang SC", "Hiragino Sans GB"]
  plt.rcParams["axes.unicode_minus"] = False
- 图要有信息密度:用上取到的全部数据点(如季度序列),别只挑两三个点连线;
  指标要常规有意义(营收/净利润/毛利率/负债率等),不自造无意义合成指标。

# 档案取回
