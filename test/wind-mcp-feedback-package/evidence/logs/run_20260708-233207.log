def tool_wind(env, server_type, tool_name, params):
    p = subprocess.run(
        ["node", "cli.mjs", "call", server_type, tool_name, json.dumps(params, ensure_ascii=False)],
        capture_output=True, text=True, timeout=BASH_TIMEOUT, cwd=WIND_CLI,
        env={"PATH": "/opt/homebrew/bin:/usr/bin:/bin", "HOME": str(Path.home()),
             "WIND_API_KEY": wind_key(), "NO_PROXY": "wind.com.cn,.wind.com.cn"},
    )
    try:  # 拆掉 MCP 信封只回传数据本体,少喂模型一层嵌套
        text = json.loads(p.stdout)["content"][0]["text"]
    except (json.JSONDecodeError, KeyError, IndexError, TypeError):
        return p.stdout.strip() or f"wind 调用失败: {p.stderr.strip()[:300]}"
    if len(text) <= DATA_SPILL_CHARS:
        return text
    return data_receipt(env, text, f"{server_type}.{tool_name}({json.dumps(params, ensure_ascii=False)})")


def data_receipt(env, text, source):
    """大数据落盘,数组里只留回执(文件名+字段含义+行数+首末样例)——数据永不进对话。"""
    env["data_seq"] += 1
    rel = f".agent/data/wind_{env['data_seq']:03d}.json"
    f = env["repo"] / rel
    f.parent.mkdir(parents=True, exist_ok=True)
    f.write_text(text, encoding="utf-8")
    meta = ""
    try:
        d = json.loads(text)["data"]
        rows = d.get("rows") or next((v for v in d.values() if isinstance(v, list)), [])
        cols = [c["name"] if isinstance(c, dict) else str(c) for c in d.get("columns", [])]
        meta = (f"字段: {', '.join(cols) or '(见文件)'}\n行数: {len(rows)}\n"
                f"首行: {json.dumps(rows[0], ensure_ascii=False)[:200] if rows else '-'}\n"
                f"末行: {json.dumps(rows[-1], ensure_ascii=False)[:200] if rows else '-'}")
    except (json.JSONDecodeError, KeyError, TypeError, StopIteration):
        meta = f"(非标准表格,共 {len(text)} 字符)"
    return (f"[数据已落盘] {rel}(来源: {source})\n{meta}\n"
            f"判断此数据是否有用;有用则现场编程取切片(python3/jq 读该文件),禁止 cat 整个文件。")


