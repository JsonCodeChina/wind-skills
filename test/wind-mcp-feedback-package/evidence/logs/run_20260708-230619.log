[23:10:21] TOOL    bash {"command": "cat > /tmp/gen_chart.py << 'PYEOF'\nimport json\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\nimport pandas as pd\nimport numpy as np\n\n# 字体设置\nplt.rcParams[\"font.sans-serif\"] = [\"PingFang SC\", \"Hiragino Sans GB\"]\nplt.rcParams[\"axes.unicode_minus\"] = False\n\n# 读取数据\nwith open('.agent/data/market_data.json') as f:\n    market = json.load(f)\nwith open('.agent/data/financial_data.json') as f:\n    fin = json.load(f)\n\n# ---- 行情数据按月取收盘价 ----\nmkt_df = pd.DataFrame(market['data'])\nmkt_df['date'] = pd.to_datetime(mkt_df['date'])\nmkt_df = mkt_df.sort_values('date')\n\n# 为了与年报对齐，取每年12月底的收盘价作为\"年末收盘价\"\n# 另外取每年的均价作为参考\nmkt_df['year'] = mkt_df['date'].dt.year\nyearly_close = mkt_df.groupby('year').last()['close'].reset_index()\nyearly_close.columns = ['year', 'year_end_close']\n\n# 年度均价\nyearly_avg = mkt_df.groupby('year')['close'].mean().reset_index()\nyearly_avg.columns = ['year', 'year_avg_close']\n\n# 年初开盘价（取每年1月）\nyearly_open = mkt_df[mkt_df['date'].dt.month == 1].groupby('year').first()['close'].reset_index()\nyearly_open.columns = ['year', 'year_open_close']\n\n# ---- 财务数据 ----\nfin_df = pd.DataFrame(fin['annual_data'])\n\n# 合并\ndf = fin_df.merge(yearly_close, on='year', how='left')\ndf = df.merge(yearly_avg, on='year', how='left')\ndf = df.merge(yearly_open, on='year', how='left')\n\nprint(\"合并后的数据框：\")\nprint(df.to_string(index=False))\n\n# ---- 创建图表 ----\nfig = plt.figure(figsize=(16, 12))\n\n# 颜色\ncolor_revenue = '#2196F3'\ncolor_profit = '#4CAF50'\ncolor_price = '#FF5722'\ncolor_margin = '#9C27B0'\ncolor_debt = '#FF9800'\n\n# ---- 图1: 股价走势 vs 营收/净利润 (双轴图) ----\nax1 = fig.add_subplot(2, 2, (1, 2))\nax1_twin = ax1.twinx()\n\nyears = df['year'].values\nrevenue = df['revenue_billion'].values\nprofit = df['net_profit_billion'].values\nprice = df['year_avg_close'].values\nprice_end = df['year_end_close'].values\n\n# 营收柱状图\nbars_rev = ax1.bar(years - 0.2, revenue, width=0.35, color=color_revenue, alpha=0.7, label='营收(亿元)', zorder=2)\n# 净利润柱状图\nbars_profit = ax1.bar(years + 0.2, profit, width=0.35, color=color_profit, alpha=0.7, label='净利润(亿元)', zorder=2)\n\n# 股价折线(年均价)\nline_price, = ax1_twin.plot(years, price, color=color_price, marker='o', linewidth=2.5, markersize=8, label='年均收盘价(元)', zorder=3)\n\n# 同时画年末收盘价虚线\nline_price_end, = ax1_twin.plot(years, price_end, color=color_price, linestyle='--', marker='s', linewidth=1.5, markersize=6, alpha=0.6, label='年末收盘价(元)', zorder=2)\n\nax1.set_xlabel('年度', fontsize=12)\nax1.set_ylabel('营收/净利润 (亿元)', fontsize=12, color='#333333')\nax1_twin.set_ylabel('收盘价 (元)', fontsize=12, color='#333333')\n\nax1.set_xticks(years)\nax1.set_xticklabels([str(int(y)) for y in years], fontsize=11)\n\n# 合并图例\nlines1, labels1 = ax1.get_legend_handles_labels()\nlines2, labels2 = ax1_twin.get_legend_handles_labels()\nax1.legend(lines1 + lines2, labels1 + labels2, loc='upper left', fontsize=10)\n\nax1.grid(axis='y', alpha=0.3)\nax1.set_title('宁德时代 年度营收/净利润 vs 股价走势 (2020-2025)', fontsize=14, fontweight='bold')\n\n# 在柱子上标注数值\nfor bar in bars_rev:\n    h = bar.get_height()\n    ax1.annotate(f'{h:.0f}', xy=(bar.get_x() + bar.get_width()/2, h),\n                xytext=(0, 3), textcoords=\"offset points\", ha='center', va='bottom', fontsize=8, color=color_revenue)\nfor bar in bars_profit:\n    h = bar.get_height()\n    ax1.annotate(f'{h:.0f}', xy=(bar.get_x() + bar.get_width()/2, h),\n                xytext=(0, 3), textcoords=\"offset points\", ha='center', va='bottom', fontsize=8, color=color_profit)\n\n# ---- 图2: 毛利率与资产负债率 ----\nax2 = fig.add_subplot(2, 2, 3)\nax2_twin = ax2.twinx()\n\nline_margin, = ax2.plot(years, df['gross_margin_pct'].values, color=color_margin, marker='D', linewidth=2.5, markersize=8, label='毛利率(%)')\nline_debt, = ax2_twin.plot(years, df['debt_ratio_pct'].values, color=color_debt, marker='^', linewidth=2.5, markersize=8, label='资产负债率(%)')\n\n# 在数据点上标注数值\nfor i, y in enumerate(years):\n    ax2.annotate(f'{df[\"gross_margin_pct\"].values[i]:.1f}%', (y, df[\"gross_margin_pct\"].values[i]),\n                textcoords=\"offset points\", xytext=(0, 10), ha='center', fontsize=9, color=color_margin)\n    ax2_twin.annotate(f'{df[\"debt_ratio_pct\"].values[i]:.1f}%', (y, df[\"debt_ratio_pct\"].values[i]),\n                     textcoords=\"offset points\", xytext=(0, -15), ha='center', fontsize=9, color=color_debt)\n\nax2.set_xlabel('年度', fontsize=12)\nax2.set_ylabel('毛利率 (%)', fontsize=12, color=color_margin)\nax2_twin.set_ylabel('资产负债率 (%)', fontsize=12, color=color_debt)\nax2.set_xticks(years)\nax2.set_xticklabels([str(int(y)) for y in years], fontsize=11)\n\nlines_a, labels_a = ax2.get_legend_handles_labels()\nlines_b, labels_b = ax2_twin.get_legend_handles_labels()\nax2.legend(lines_a + lines_b, labels_a + labels_b, loc='best', fontsize=10)\n\nax2.grid(axis='y', alpha=0.3)\nax2.set_title('宁德时代 毛利率与资产负债率趋势 (2020-2025)', fontsize=14, fontweight='bold')\n\n# ---- 图3: 月度股价走势全貌 ----\nax3 = fig.add_subplot(2, 2, 4)\n\nmkt_df_plot = mkt_df.copy()\ncolors_month = ['#E8F5E9' if x['chg_pct'] >= 0 else '#FFEBEE' for _, x in mkt_df_plot.iterrows()]\nbars_colors = ['#4CAF50' if x >= 0 else '#F44336' for x in mkt_df_plot['chg_pct']]\n\nax3.bar(range(len(mkt_df_plot)), mkt_df_plot['close'], color='#BBDEFB', alpha=0.5, width=0.8, label='月收盘价')\nax3_twin2 = ax3.twinx()\nax3_twin2.bar(range(len(mkt_df_plot)), mkt_df_plot['chg_pct'], color=bars_colors, alpha=0.6, width=0.8, label='月涨跌幅')\n\nax3.set_xlabel('月份序列 (2021-07 ~ 2026-07)', fontsize=11)\nax3.set_ylabel('收盘价 (元)', fontsize=11, color='#1565C0')\nax3_twin2.set_ylabel('月涨跌幅 (%)', fontsize=11, color='#333')\n\n# 每隔12个月标一个时间点\ntick_positions = list(range(0, len(mkt_df_plot), 12))\ntick_labels = [mkt_df_plot.iloc[i]['month'] for i in tick_positions]\nax3.set_xticks(tick_positions)\nax3.set_xticklabels(tick_labels, fontsize=9, rotation=20)\n\nlines3a, labels3a = ax3.get_legend_handles_labels()\nlines3b, labels3b = ax3_twin2.get_legend_handles_labels()\nax3.legend(lines3a + lines3b, labels3a + labels3b, loc='upper left', fontsize=9)\n\nax3.grid(axis='y', alpha=0.2)\nax3.set_title('宁德时代 月度股价与涨跌幅全景 (2021.07-2026.07)', fontsize=13, fontweight='bold')\n\nplt.tight_layout(pad=3.0)\nplt.savefig('.agent/data/catl_analysis.png', dpi=150, bbox_inches='tight')\nprint(\"\\n图表已保存至 .agent/data/catl_analysis.png\")\nPYEOF\npython3 /tmp/gen_chart.py"}
