[01:34:13] TOOL    bash {"command": "cd \"/Users/lufeng/Projects/fin-agent/runs/20260709-012653\" && python3 -c \"\nimport json\n\nstocks = [\n    ('wind_021.json', '603501.SH', '豪威集团', '设计'),\n    ('wind_022.json', '002049.SZ', '紫光国微', '设计'),\n    ('wind_023.json', '603986.SH', '兆易创新', '设计'),\n    ('wind_024.json', '688041.SH', '海光信息', '设计'),\n    ('wind_025.json', '688256.SH', '寒武纪', '设计'),\n    ('wind_026.json', '688981.SH', '中芯国际', '制造'),\n    ('wind_027.json', '688396.SH', '华润微', '制造'),\n    ('wind_028.json', '600703.SH', '三安光电', '制造'),\n    ('wind_029.json', '688347.SH', '华虹公司', '制造'),\n    ('wind_030.json', '600584.SH', '长电科技', '封测'),\n    ('wind_031.json', '002185.SZ', '华天科技', '封测'),\n    ('wind_032.json', '002371.SZ', '北方华创', '设备'),\n    ('wind_033.json', '688012.SH', '中微公司', '设备'),\n    ('wind_034.json', '688126.SH', '沪硅产业', '材料'),\n    ('wind_035.json', '002409.SZ', '雅克科技', '材料'),\n]\n\nresults = []\nfor fname, code, name, sector in stocks:\n    with open(f'.agent/data/{fname}') as f:\n        data = json.load(f)\n    rows = data['data']['rows']\n    # 首日收盘 / 末日收盘\n    first_close = float(rows[0][2])   # MATCH\n    last_close  = float(rows[-1][2])\n    chg_pct = (last_close - first_close) / first_close * 100\n    \n    # 年内最高最低\n    highs = [float(r[3]) for r in rows]\n    lows = [float(r[4]) for r in rows]\n    high_max = max(highs)\n    low_min = min(lows)\n    high_date_idx = highs.index(high_max)\n    low_date_idx = lows.index(low_min)\n    high_date = rows[high_date_idx][9]\n    low_date = rows[low_date_idx][9]\n    \n    results.append((code, name, sector, first_close, last_close, chg_pct, low_min, high_max, low_date, high_date))\n\n# 输出\nprint(f'{\\\"代码\\\":<10} {\\\"名称\\\":<8} {\\\"环节\\\":<6} {\\\"期初价\\\":>8} {\\\"期末价\\\":>8} {\\\"涨跌幅\\\":>8} {\\\"最低\\\":>8} {\\\"最高\\\":>8} {\\\"最低日\\\":>10} {\\\"最高日\\\":>10}')\nprint('-' * 90)\nfor r in results:\n    code, name, sector, fc, lc, chg, lo, hi, lod, hid = r\n    print(f'{code:<10} {name:<8} {sector:<6} {fc:>8.2f} {lc:>8.2f} {chg:>+7.2f}% {lo:>8.2f} {hi:>8.2f} {lod:>10} {hid:>10}')\n\nprint()\nprint('=== 涨跌幅排名（从高到低）===')\nresults.sort(key=lambda x: x[5], reverse=True)\nfor i, r in enumerate(results, 1):\n    print(f'{i:>2}. {r[1]:<8}({r[0]:<10}) [{r[2]:<4}] {r[5]:>+7.2f}%')\n\"\n"}
