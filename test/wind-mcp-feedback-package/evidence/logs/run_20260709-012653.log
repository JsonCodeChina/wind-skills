ved: valuation_scatter.png\")\n\n# ===== 图4: 各环节涨跌幅汇总（分组柱状图） =====\nfig, ax = plt.subplots(figsize=(10, 6))\nsegments_avg = {\n    '芯片设计\\n(5家)': np.mean([s[1] for s in stocks if s[0] in ['豪威集团','紫光国微','兆易创新','海光信息','寒武纪']]),\n    '晶圆代工\\n(4家)': np.mean([s[1] for s in stocks if s[0] in ['中芯国际','华润微','三安光电','华虹公司']]),\n    '封测\\n(2家)': np.mean([s[1] for s in stocks if s[0] in ['长电科技','华天科技']]),\n    '设备\\n(2家)': np.mean([s[1] for s in stocks if s[0] in ['北方华创','中微公司']]),\n    '材料\\n(2家)': np.mean([s[1] for s in stocks if s[0] in ['沪硅产业','雅克科技']]),\n}\nseg_names = list(segments_avg.keys())\nseg_values = list(segments_avg.values())\nbar_colors = ['#3498db','#e74c3c','#2ecc71','#f39c12','#9b59b6']\nbars = ax.bar(seg_names, seg_values, color=bar_colors, width=0.6, edgecolor='black', linewidth=0.5)\nfor bar, v in zip(bars, seg_values):\n    ax.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 5,\n            f'{v:.1f}%', ha='center', fontsize=11, fontweight='bold')\nax.set_ylabel('平均涨跌幅（%）', fontsize=12)\nax.set_title('芯片产业链各环节近1年平均涨跌幅', fontsize=14, fontweight='bold')\nax.axhline(y=0, color='gray', linewidth=0.8)\nax.grid(axis='y', alpha=0.3)\nplt.tight_layout()\nplt.savefig('segment_avg_change.png', dpi=150, bbox_inches='tight')\nplt.close()\nprint(\"图4 saved: segment_avg_change.png\")\n\nprint(\"\\n所有图表生成完成！\")\nPYEOF"}
