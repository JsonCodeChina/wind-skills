[01:33:27] TOOL    bash {"command": "cd \"/Users/lufeng/Projects/fin-agent/runs/20260709-012653\" && python3 -c \"\nimport json\n\n# 读取所有文件的首日/末日收盘价\nstocks = [\n    ('603501.SH', '豪威集团', 'wind_006.json'),\n    ('002049.SZ', '紫光国微', 'wind_007.json'),\n    ('603986.SH', '兆易创新', 'wind_008.json'),\n    ('688041.SH', '海光信息', 'wind_009.json'),\n    ('688256.SH', '寒武纪', 'wind_010.json'),\n    ('688981.SH', '中芯国际', 'wind_011.json'),\n    ('688396.SH', '华润微', 'wind_012.json'),\n    ('600703.SH', '三安光电', 'wind_013.json'),\n    ('688347.SH', '华虹公司', 'wind_014.json'),\n    ('600584.SH', '长电科技', 'wind_015.json'),\n    ('002185.SZ', '华天科技', 'wind_016.json'),\n    ('002371.SZ', '北方华创', 'wind_017.json'),\n    ('688012.SH', '中微公司', 'wind_018.json'),\n    ('688126.SH', '沪硅产业', 'wind_019.json'),\n    ('002409.SZ', '雅克科技', 'wind_020.json'),\n]\n\nresults = []\nfor code, name, fname in stocks:\n    with open(f'.agent/data/{fname}') as f:\n        data = json.load(f)\n    rows = data.get('data', [])\n    if not rows:\n        continue\n    # 找到最早和最晚日期的数据\n    dates = {}\n    for row in rows:\n        d = row['_DATE']\n        if d not in dates:\n            dates[d] = []\n        dates[d].append(float(row['MATCH']))\n    sorted_dates = sorted(dates.keys())\n    first_date = sorted_dates[0]\n    last_date = sorted_dates[-1]\n    first_close = dates[first_date][-1]  # 当天最后一笔\n    last_close = dates[last_date][-1]\n    chg_pct = (last_close - first_close) / first_close * 100\n    results.append((code, name, first_date, first_close, last_date, last_close, chg_pct))\n    print(f'{name}({code}): {first_date}开盘价={first_close:.2f} -> {last_date}收盘价={last_close:.2f}, 涨跌幅={chg_pct:.2f}%')\n\nprint()\nprint('=== 涨跌幅排名 ===')\nresults.sort(key=lambda x: x[6], reverse=True)\nfor i, (code, name, fd, fc, ld, lc, chg) in enumerate(results, 1):\n    print(f'{i}. {name}({code}): {chg:+.2f}%')\n\"\n"}
