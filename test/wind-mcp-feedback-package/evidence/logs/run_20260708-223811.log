[22:39:40] TOOL    edit_file {"path": "financial_analysis.py", "old_str": "", "new_str": "import json\nimport matplotlib.pyplot as plt\nimport pandas as pd\n\n# 从wind数据中获取的财务数据示例\nraw_data = [\n    [\"300750.SZ\", \"宁德时代\", \"Q4 FY2023\", 7171.6804, 4972.8489, 1977.0805, 4009.1704, 3567.1859, 537.183, 539.1405, 467.6103, 441.2125, 928.2612, -291.8776, 147.1636, 805.3617, \"CNY\"],\n    [\"300750.SZ\", \"宁德时代\", \"Q4 FY2024\", 7866.5812, 5132.0195, 2469.3003, 3620.1255, 3125.9975, 640.518, 631.8204, 540.0679, 507.4468, 969.9035, -488.7531, -145.2424, 319.9425, \"CNY\"],\n    [\"300750.SZ\", \"宁德时代\", \"Q4 FY2025\", 9748.2754, 6038.0122, 3371.0775, 4237.0183, 3539.0295, 895.1864, 895.2655, 767.8631, 722.0128, 1332.1998, -944.7579, -63.0954, 297.7001, \"CNY\"]\n]\n\ncols = [\"Wind代码\", \"证券简称\", \"日期\", \"资产总计\", \"负债合计\", \"归属母公司股东的权益\", \"营业总收入\", \"营业总成本\", \"营业利润\", \"利润总额\", \"净利润\", \"归属母公司股东的净利润\", \"经营活动产生的现金流量净额\", \"投资活动产生的现金流量净额\", \"筹资活动产生的现金流量净额\", \"现金及现金等价物净增加额\", \"记账本位币\"]\n\ndf = pd.DataFrame(raw_data, columns=cols)\n\n# 指标计算\n# 净利润增长率 = (本期净利润 - 上期净利润) / 上期净利润\n# 负债率 = 负债合计 / 资产总计\n\n# 计算净利润增长率\n净利润 = df[\"归属母公司股东的净利润\"]\n净利润增长率 = 净利润.pct_change().fillna(0) * 100\n\n# 计算负债率\n负债率 = df[\"负债合计\"] / df[\"资产总计\"] * 100\n\n# 现金流量净额综合指标（经营、投资和筹资活动之和）\n现金流合计 = df[\"经营活动产生的现金流量净额\"] + df[\"投资活动产生的现金流量净额\"] + df[\"筹资活动产生的现金流量净额\"]\n\n# 绘制图表\nplt.figure(figsize=(10, 8))\n\nplt.subplot(3, 1, 1)\nplt.plot(df[\"日期\"], 净利润, marker='o')\nplt.title(\"归属母公司股东的净利润 (亿元)\")\nplt.grid(True)\n\nplt.subplot(3, 1, 2)\nplt.plot(df[\"日期\"], 净利润增长率, marker='o', color='orange')\nplt.title(\"净利润增长率 (%)\")\nplt.grid(True)\n\nplt.subplot(3, 1, 3)\nplt.plot(df[\"日期\"], 负债率, marker='o', color='green')\nplt.title(\"负债率 (%)\")\nplt.grid(True)\n\nplt.tight_layout()\nplt.savefig(\"financial_analysis_chart.png\")\n\n# 生成报告文本\nreport = f\"\"\"\n宁德时代最近三年财务分析报告\n\n数据来源: Wind 万得 analytics_data.get_financial_data\n\n关键指标:\n- 归属母公司股东的净利润(亿元): {净利润.values.tolist()}\n- 净利润增长率(%): {净利润增长率.values.tolist()}\n- 负债率(%): {负债率.values.tolist()}\n- 现金流量净额合计(亿元): {现金流合计.values.tolist()}\n\n见附带图表文件: financial_analysis_chart.png\n\"\"\"\n\nwith open(\"report.md\", \"w\", encoding=\"utf-8\") as f:\n    f.write(report)\n"}
